<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pink"
    tools:context=".About_us_Fragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="91dp"
            android:fontFamily="sans-serif-light"
            android:text="\nAbout LiwsNailz! ✨"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="
Hi there! I’m a beginner nail tech with a passion for creativity and beauty. LiwsNailz is my little space where I’m learning, growing, and perfecting my skills—one set at a time!\n

I’m all about experimenting with new designs, techniques, and styles, and I’d love for you to be part of this journey. Whether you're after a simple, classy look or something bold and unique, I’m here to bring your nail ideas to life while refining my craft.\n

Come along as I learn and develop—your support means everything! Let’s create something beautiful together. 💖\n"
            android:textAlignment="center"
            android:textSize="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="Contact us"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="30dp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/email">
        </ImageView>

        <TextView
            android:id="@+id/email_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: info@liwsnailz.com"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/blue"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/phone">
        </ImageView>


        <TextView
            android:id="@+id/phone_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone number: +44 123 456 789"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/blue"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/instagram">
        </ImageView>

        <TextView
            android:id="@+id/instagram_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instagram: LiwsNailz\n"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/blue"/>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/findUsHere_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-light"
                android:text="Find us here "
                android:layout_marginBottom="20dp"
                android:textColor="@color/black"
                android:textSize="30sp" />

            <!--Map-->
            <fragment
                android:id="@+id/map"
                class="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_marginBottom="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_height="250dp"
                android:layout_below="@id/findUsHere_text" />
        </RelativeLayout>

        <TextView
            android:id="@+id/clickHereForDirections_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/map"
            android:layout_marginBottom="5dp"
            android:fontFamily="sans-serif-light"
            android:text="Click here for directions"
            android:textColor="@color/blue"
            android:textStyle="bold"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
             />

        <TextView
                android:id="@+id/openingHours_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/clickHereForDirections_text"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-light"
                android:text="Opening hours"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_centerHorizontal="true"/>

            <TextView
                android:id="@+id/openingHours"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/openingHours_text"
                android:layout_marginBottom="20dp"
                android:fontFamily="sans-serif-light"
                android:text="Monday:17:00-22:00\nTuesday:17:00-22:00\nWednesday17:00-22:00\nThursday17:00-22:00\nFriday17:00-22:00\nSaturday:10:00-20:00\nSunday:12:00-20:00"
                android:textColor="@color/black"
                android:textSize="15dp" />


    </LinearLayout>

    </ScrollView>
</FrameLayout>
